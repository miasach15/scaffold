VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Public half of the VAPID key pair used for "What now?" push notifications — safe to
# expose client-side. Generate a pair with `npx web-push generate-vapid-keys` and put the
# private half only in the generate-vapid-keys / send-whatnow-push Supabase function secrets.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
